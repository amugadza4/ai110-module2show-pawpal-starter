classDiagram

    class Owner {
        +String name
        +List~Pet~ pets
        +add_pet(pet)
        +get_all_tasks()
    }

    class Pet {
        +String name
        +String species
        +int age
        +List~Task~ tasks
        +add_task(task)
        +get_tasks()
    }

    class Task {
        +String description
        +String time
        +String frequency
        +bool completed
        +mark_complete()
    }

    class Scheduler {
        +Owner owner
        +get_all_tasks()
        +sort_by_time()
        +filter_tasks()
        +detect_conflicts()
    }

    Owner "1" --> "0..*" Pet : has
    Pet "1" --> "0..*" Task : has
    Scheduler --> Owner : manages
